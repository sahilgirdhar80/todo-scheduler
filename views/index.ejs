<%- include('partials/header.ejs'); -%>

  <div class="box" id="heading">
    <h1>
      <%= listTitle %> Tasks
    </h1>

    <!-- Navigation -->
    <nav style="margin-top: 10px;">
      <a href="/daily">Daily</a> |
      <a href="/weekly">Weekly</a> |
      <a href="/monthly">Monthly</a>
    </nav>
  </div>

  <div class="box">
    <% for(let item of listItems) { %>
      <div class="item">
        <!-- Delete Form -->
        <form action="/delete" method="post">
          <input type="checkbox" onchange="this.form.submit()" name="deleteItemId" value="<%= item.id %>">
          <input type="hidden" name="category" value="<%= category %>">
        </form>

        <!-- Display Title -->
        <p id="title<%= item.id %>">
          <%= item.title %>
        </p>

        <!-- Edit Form -->
        <form class="edit" action="/edit" method="post">
          <input type="hidden" name="updatedItemId" value="<%= item.id %>">
          <input type="hidden" name="category" value="<%= category %>">
          <input id="input<%= item.id %>" type="text" name="updatedItemTitle" value="<%= item.title %>"
            autocomplete="off" hidden="true" />
          <button id="done<%= item.id %>" class="edit" type="submit" hidden>
            <img class="icon" src="/assets/icons/check-solid.svg" alt="tick image">
          </button>
        </form>

        <!-- Edit Button -->
        <button id="edit<%= item.id %>" class="edit" onclick="handler('<%= item.id %>')">
          <img class="icon" src="/assets/icons/pencil-solid.svg" alt="pencil image">
        </button>
      </div>
      <% } %>

        <!-- Add Form -->
        <form class="item" action="/add" method="post" id="addForm">
          <input type="text" id="itemInput" name="newItem" placeholder="New Item" autocomplete="off" />
          <input type="hidden" name="category" value="<%= category %>">
          <button class="add" type="submit">+</button>
        </form>
  </div>

  <!-- Edit Mode Handler -->
  <script>
    function handler(id) {
      document.getElementById("title" + id).setAttribute("hidden", true);
      document.getElementById("edit" + id).setAttribute("hidden", true);
      document.getElementById("done" + id).removeAttribute("hidden");
      document.getElementById("input" + id).removeAttribute("hidden");
    }

    // Client-side form validation
    document.getElementById("addForm").addEventListener("submit", function (e) {
      const value = document.getElementById("itemInput").value.trim();
      if (value === "") {
        e.preventDefault();
        alert("Please enter a valid item.");
      }
    });
  </script>

  <%- include('partials/footer.ejs'); -%>